{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "permissions": {
    "additionalDirectories": ["../Docs"],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(app/**)",
      "Edit(core/**)",
      "Edit(data/**)",
      "Edit(domain/**)",
      "Edit(feature/**)",
      "Edit(push/**)",
      "Edit(docs/**)",
      "Bash(./gradlew *)",
      "Bash(bash scripts/sync-docs.sh)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(scripts/**)",
      "Edit(CLAUDE.md)",
      "Edit(settings.gradle.kts)",
      "Edit(build-logic/**)",
      "Edit(gradle/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(gh pr merge*)",
      "Edit(../Docs/**)",
      "Read(./local.properties)",
      "Read(./keystore.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./app/google-services.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/sync-docs.sh\"" }
        ]
      }
    ]
  }
}
