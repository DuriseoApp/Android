<?xml version="1.0" encoding="utf-8"?>
<!-- 상태바 알림의 작은 아이콘 (D-162): 앱 아이콘 마크(design/logo/duriseo-mark.svg)의 두 원을 합친 흰 실루엣 한 색.
     상태바는 투명도만 쓰므로 색은 흰색이고, 강조색 brand-500은 NotificationCompat의 color로 준다.
     마크 좌표(두 원 x 24~84, y 34~74, 중심 (54, 54))를 24dp 안 가로 20dp(양쪽 패딩 2dp)에 맞춰 줄인다 (viewport 72 = 60의 1.2배) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <!-- 마크 중심 (54, 54)를 viewport 중심 (36, 36)으로 옮긴다 -->
    <group
        android:translateX="-18"
        android:translateY="-18">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M24,54a20,20 0 1,0 40,0a20,20 0 1,0 -40,0z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M44,54a20,20 0 1,0 40,0a20,20 0 1,0 -40,0z" />
    </group>
</vector>
